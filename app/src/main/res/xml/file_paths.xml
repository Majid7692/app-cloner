<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths for the file shuttle.
  Only the app's own private files and cache may be shared, and only
  as content:// URIs with a temporary grant. Nothing outside these
  folders is reachable through the provider.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="shared_files" path="shared/" />
    <cache-path name="shared_cache" path="shared/" />
</paths>
