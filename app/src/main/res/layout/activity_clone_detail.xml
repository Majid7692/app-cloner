<?xml version="1.0" encoding="utf-8"?>
<!-- One clone: rename, re-icon, shortcut, freeze, remove. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/clone_detail_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/detail_package_label"
                android:textColor="@color/muted_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/clonePackageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/clonedOnText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/frozenText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/detail_frozen_note"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/detail_name_label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/cloneNameInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:hint="@string/detail_name_hint"
                android:inputType="text"
                android:textSize="17sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveNameButton"
                style="@style/Widget.AppCloner.BigButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/detail_save_name" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickIconButton"
                style="@style/Widget.AppCloner.BigButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/detail_pick_icon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shortcutButton"
                style="@style/Widget.AppCloner.BigButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/detail_shortcut" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/freezeButton"
                style="@style/Widget.AppCloner.BigButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/detail_freeze" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recloneButton"
                style="@style/Widget.AppCloner.BigButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/detail_reclone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/removeButton"
                style="@style/Widget.AppCloner.BigButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/detail_remove" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
